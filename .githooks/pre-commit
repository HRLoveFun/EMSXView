#!/bin/bash
# Pre-commit hook: 自动同步 CODEBUDDY.md 与 AGENTS.md
# 规范源为 AGENTS.md；若仅 CODEBUDDY.md 被编辑，则反向同步
# 设置方式: git config core.hooksPath .githooks

CB="CODEBUDDY.md"
AG="AGENTS.md"

# 检查是否有任一文件被暂存
CB_STAGED=$(git diff --cached --name-only -- "$CB")
AG_STAGED=$(git diff --cached --name-only -- "$AG")

# 均未暂存则跳过
if [ -z "$CB_STAGED" ] && [ -z "$AG_STAGED" ]; then
    exit 0
fi

# 确定同步方向：优先 AGENTS.md，其次 CODEBUDDY.md
SRC=""
if [ -n "$AG_STAGED" ]; then
    SRC="$AG"
elif [ -n "$CB_STAGED" ]; then
    SRC="$CB"
fi

sync_files() {
    local src="$1"; shift
    for f in "$@"; do
        # 内容一致则无需写入
        if git diff --no-index --quiet "$src" "$f" 2>/dev/null; then
            continue
        fi
        git show :"$src" > "$f"
        git add "$f"
        echo "[pre-commit] 已同步 ${src} → ${f}"
    done
}

# 规范源暂存 → 同步到另一份
case "$SRC" in
    "$AG") sync_files "$AG" "$CB" ;;
    "$CB") sync_files "$CB" "$AG" ;;
esac

# ═══════════════════════════════════════════════════════════════════════
# 质量门禁增量快检 (2026-08-21)
# 仅当暂存文件含 .py/.ts/.tsx 时执行。
# - AP-xx 契约违规：立即阻断（与既有边界审计行为一致）
# - OE-xx 过度工程：基线演进 — 新增阻断 / 存量放行 / 修复正向提示
# 底层通过 scripts/quality_gate.py --staged 调用，AP 适配层仍执行既有
# audit_*.py 三个脚本（零重写零回归）；OE 检测器受 25s 预算 fail-open 保护。
# ═══════════════════════════════════════════════════════════════════════
CODE_STAGED=$(git diff --cached --name-only | grep -E '\.(py|ts|tsx)$' || true)
if [ -n "$CODE_STAGED" ] && command -v python >/dev/null 2>&1; then
    if ! printf "%s\n" "$CODE_STAGED" | python scripts/quality_gate.py --staged --quiet; then
        echo "[pre-commit] 质量门禁阻断：存在 AP 契约违规或新增过度工程信号"
        echo "[pre-commit] 存量问题未阻断；修复建议见上方输出"
        exit 1
    fi
fi

exit 0
