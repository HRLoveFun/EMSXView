# ==============================================================
# EMSX Trading Tool – Frontend Environment Variables
# Copy this file to .env and edit as needed
# ==============================================================

# Backend API URL.
# Leave empty to run in mock mode without a real Bloomberg backend.
# In production the Vite dev-server proxy is not used – Nginx
# forwards /api/* to the backend, so leave this blank for prod
# docker-compose builds. Set it only for standalone dev sessions
# against a remote backend.
VITE_API_URL=

# MarketView microservice URL (independent service, default :8001).
# The Vite dev proxy forwards /api/marketview/* here; leave blank to use
# http://localhost:8001. Production routes the same prefix via Nginx.
VITE_MARKETVIEW_URL=
