# EMSX Trading API - Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# Bloomberg Terminal Configuration
# =============================================================================

# Bloomberg Terminal host (use 'host.docker.internal' for local Docker Desktop)
# For Windows: use host IP or 'host.docker.internal'
# For Linux: use host IP or set 'extra_hosts' in docker-compose
BLOOMBERG_HOST=host.docker.internal

# Bloomberg API port (default: 8194)
BLOOMBERG_PORT=8194

# Request timeout in milliseconds
BLOOMBERG_TIMEOUT=30000

# =============================================================================
# API Server Configuration
# =============================================================================

# API server port (default: 3000)
API_PORT=3000

# Number of worker processes (1 for Bloomberg API compatibility)
API_WORKERS=1

# =============================================================================
# Security Configuration
# =============================================================================

# JWT Secret Key — REQUIRED for production!
# Generate a secure key with: openssl rand -hex 32
# This MUST be set to a secure random value in production
JWT_SECRET=

# JWT Token expiration in minutes (default: 480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# Allowed trader usernames (comma-separated)
# Leave empty to allow all authenticated users
ALLOWED_TRADERS=trader1,trader2

# Frontend API Key for service-to-service authentication
FRONTEND_API_KEY=your-frontend-api-key

# =============================================================================
# Authentication Bypass (DEVELOPMENT ONLY)
# =============================================================================

# ⚠️ DANGER: Set to 'true' to bypass JWT authentication
# This should ONLY be used in local development
# NEVER enable this in production or shared environments
BYPASS_AUTH=false

# =============================================================================
# Trading Configuration
# =============================================================================

# Maximum number of orders in a batch update
MAX_BATCH_SIZE=100

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173,http://127.0.0.1:80

# =============================================================================
# Feature Flags
# =============================================================================

# Enable real-time WebSocket updates
ENABLE_REALTIME=true

# Enable audit logging
ENABLE_AUDIT_LOG=true

# =============================================================================
# Frontend Configuration
# =============================================================================

# Frontend port (default: 80)
FRONTEND_PORT=80

# =============================================================================
# Monitoring (Optional)
# =============================================================================

# Prometheus port (default: 9090)
PROMETHEUS_PORT=9090

# Grafana port (default: 3001)
GRAFANA_PORT=3001

# Grafana admin credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-in-production

# =============================================================================
# Development Settings
# =============================================================================

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Recommended: WARNING for production (reduces noise), INFO for debugging
LOG_LEVEL=WARNING

# Maximum log file size in bytes (default: 5242880 = 5 MB)
LOG_MAX_BYTES=5242880

# Number of backup files to keep (default: 3)
LOG_BACKUP_COUNT=3

# Maximum age of log files in days (default: 3)
LOG_MAX_AGE_DAYS=3

# Log directory path (relative to backend/ or absolute)
# Default: ../../logs (project root logs folder)
LOG_DIR=../../logs

# Enable debug mode (never in production!)
DEBUG=false
