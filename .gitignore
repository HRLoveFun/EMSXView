# ============================================================
# EMSX .gitignore — Comprehensive
# ============================================================

# --- Dependencies ---
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# --- Environment ---
.env
.env.local
.env.*.local
*.env

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Testing ---
coverage/
.nyc_output/
.pytest_cache/
# --- 测试运行器输出产物（如 vitest_out.txt，勿入版本库） ---
*.out.txt
vitest_out.txt

# --- Build outputs ---
app/dist/
dist-ssr/
# 独立模块构建产物（与主应用 dist/ 分离，避免互删；见 specs/013-frontend-workspaces/plan.md）
dist-modules/
.vite/
*.local

# --- Python ---
*.py[cod]
*$py.class
.mypy_cache/
.dmypy.json
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# --- Bloomberg ---
*.blp

# --- Temporary files ---
*.tmp
*.temp
.cache/

# --- Conversation / debug scratch files (see .codebuddy/rules/coding-style.md) ---
_tmp/
_tmp_*
_tmp-*

# --- Pipeline runtime artifacts ---
.pipeline.lock

# --- TCA 报告运行时产物（scripts/reports/generate_tca_report.py 输出） ---
scripts/reports/output/

# --- 质量门禁趋势库（quality_gate.py 全量扫描写入，可再生；基线历史不入库） ---
scripts/reports/quality_gate/quality_gate.db
# --- 质量门禁债务报告（--report 生成物，可再生；逐轮修复账本以
#     docs/report-tca-known-limitations.md §五 为准，避免双账本产生「哪份是真相」分叉。
#     report-20260821.md / report-20260825.md 为历史快照，保留在版本库内不再新增） ---
scripts/reports/quality_gate/report-*.md

# --- 清理门禁运行时产物（cleanup.py 写入，可再生；基线历史不入库） ---
scripts/reports/cleanup/

# --- 边界测试扫描产物（运行时生成，勿入版本库） ---
**/.scan_log.jsonl

# ============================================================
# Data files (runtime generated - NEVER commit)
# 注意：目录模式必须锚定（前导 /），否则会误伤源码树内的 data 目录
# （曾导致 frontend/src/modules/execution/data/ 兼容层未被跟踪；
#  该模块已于 2026-09-16 迁至 ExecutionView/module/data/，规则仍须保持锚定）
# ============================================================
CostView/data/
/data/
backend/api/data/
# --- 迁移数据目录（带时间戳 data.migrated.<ts>，运行产物，勿入版本库；数据应外置 D:\db） ---
CostView/data.migrated.*/

# --- 例外：golden 冻结快照是**测试夹具**（非运行时数据，与基线 JSON 同源入库） ---
# 用途：使 CI 与本地无需生产数据即可执行 CostView/tests/test_golden_samples.py 指标锁定回归；
# 更新 SOP 见 CostView/tests/golden/README.md
!CostView/tests/golden/snapshot/*.db

# ============================================================
# AI Assistant Local State (per-user runtime)
# ============================================================
.workbuddy/
.codebuddy/*
!.codebuddy/rules/
.codebuddy/rules/*
# module-boundary.md 是模块契约唯一真相源，CI 边界审计
# (scripts/audit_doc_drift.py) 依赖它 —— 必须纳入版本控制
!.codebuddy/rules/module-boundary.md
# agent-workflow.md 是全体 Agent 的作业节奏约定（等待 / 轮询一律每 5 秒），
# 需随仓库分发给所有会话才会生效 —— 同样纳入版本控制
!.codebuddy/rules/agent-workflow.md
# code-review / code-cleanup skill 随仓库分发，团队成员克隆后即可使用
!.codebuddy/skills/
.codebuddy/skills/*
!.codebuddy/skills/code-review/
!.codebuddy/skills/code-cleanup/
!.codebuddy/skills/readme-guidelines/
!.codebuddy/skills/repo-page-tree/

# --- Notebooks (with outputs) ---
*.ipynb

# --- OS generated files ---
Thumbs.db
Desktop.ini
*.xlsx
*.csv
