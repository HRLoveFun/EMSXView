# ============================================================
# EMSX .gitignore — Comprehensive
# ============================================================

# --- Dependencies ---
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# --- Environment ---
.env
.env.local
.env.*.local
*.env

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Testing ---
coverage/
.nyc_output/
.pytest_cache/

# --- Build outputs ---
app/dist/
dist-ssr/
.vite/
*.local

# --- Python ---
*.py[cod]
*$py.class
.mypy_cache/
.dmypy.json
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# --- Bloomberg ---
*.blp

# --- Temporary files ---
*.tmp
*.temp
.cache/

# --- Conversation / debug scratch files (see .codebuddy/rules/coding-style.md) ---
_tmp/
_tmp_*
_tmp-*

# --- Pipeline runtime artifacts ---
.pipeline.lock

# --- TCA 报告运行时产物（scripts/reports/generate_tca_report.py 输出） ---
scripts/reports/output/

# --- 质量门禁趋势库（quality_gate.py 全量扫描写入，可再生；基线历史不入库） ---
scripts/reports/quality_gate/quality_gate.db

# --- 边界测试扫描产物（运行时生成，勿入版本库） ---
**/.scan_log.jsonl

# ============================================================
# Data files (runtime generated - NEVER commit)
# 注意：目录模式必须锚定（前导 /），否则会误伤源码树内的 data 目录
# （曾导致 frontend/src/modules/execution/data/ 兼容层未被跟踪）
# ============================================================
CostView/data/
/data/
backend/api/data/

# ============================================================
# AI Assistant Local State (per-user runtime)
# ============================================================
.workbuddy/
.codebuddy/

# --- Notebooks (with outputs) ---
*.ipynb

# --- OS generated files ---
Thumbs.db
Desktop.ini
*.xlsx
*.csv
