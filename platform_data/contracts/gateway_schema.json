      },
      {
        "field": "MID",
        "reason": "SW/IT 等市场为 0.00"
      }
    ]
  },
  "clientRequirements": {
    "fallback": "收到 2001/3001 或连续 3 次超时后，必须熔断并回落直连；恢复需手动切回，避免抖动。",
    "stale": "source=stale 时必须向终端用户标注数据时点，不得当作实时值展示。",
    "gaps": "_meta.gaps 非空时必须按 fieldCatalog[].fallback 回落，不得填 0。",
    "noBar": "网关不提供 bar 接口；10 秒 bar 走 raw_bdib / 盘中库 bars_10s_t0。"
  }
}
