# ==============================================================
# EMSX Trading Tool – Frontend Environment Variables
# Copy this file to .env and edit as needed
# ==============================================================

# Backend API URL.
# Leave empty (or set VITE_USE_MOCK=true) to run in mock mode
# without a real Bloomberg backend.
# In production the Vite dev-server proxy is not used – Nginx
# forwards /api/* to the backend, so leave this blank for prod
# docker-compose builds. Set it only for standalone dev sessions
# against a remote backend.
VITE_API_URL=

# Set to "true" to force mock data even when VITE_API_URL is set
VITE_USE_MOCK=false
